@model List<JobAdminDashboard.Models.JobStatusRecord>
@{
    ViewBag.Title = "All Jobs";
}

<h2>All Jobs</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Job Type</th>
            <th>Status</th>
            <th>Created</th>
            <th>Started</th>
            <th>Ended</th>
            <th>Error</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var job in Model)
        {
            <tr>
                <td>@job.Id</td>
                <td>@job.JobType</td>
                <td>
                    <span class="badge bg-@GetStatusColor(job.Status)">
                        @job.Status
                    </span>
                </td>
                <td>@job.CreatedAt.ToLocalTime()</td>
                <td>@job.StartedAt?.ToLocalTime()</td>
                <td>@job.EndedAt?.ToLocalTime()</td>
                <td>@(job.ErrorMessage ?? "-")</td>
            </tr>
        }
    </tbody>
</table>

@functions {
    string GetStatusColor(string status) =>
        status switch
        {
            "Succeeded" => "success",
            "Failed" => "danger",
            "Pending" => "secondary",
            "Running" => "warning",
            _ => "light"
        };
}
